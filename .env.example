# Copy to .env and fill in what you need:   cp .env.example .env
# Everything below is optional: with no keys at all you still get local transcription + search excerpts.

# ---------------------------------------------------------------- LLM (free tiers)
# Used for the executive summary, action items, incident ticket and RAG answers.
# Gemini is tried first; Groq is used as a fallback (or on its own if it is the only key set).
#   Gemini key (free):  https://aistudio.google.com/apikey
#   Groq key (free):    https://console.groq.com/keys
GOOGLE_API_KEY=
GROQ_API_KEY=

# auto = Gemini first, Groq as fallback | gemini | groq
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash
# Provider model catalogs change; if a model is retired, pick a current one from the provider's docs.
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------- Speech-to-text
# local = faster-whisper on your CPU (default, free, audio never leaves your machine)
# assemblyai = cloud (free tier); requires ASSEMBLYAI_API_KEY, otherwise we fall back to local.
#   AssemblyAI key (free tier):  https://www.assemblyai.com/dashboard/signup
STT_PROVIDER=local
ASSEMBLYAI_API_KEY=

WHISPER_MODEL_SIZE=base      # tiny | base | small | medium | large-v3  (bigger = slower, more accurate)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Language hint, e.g. en / de / es. Leave empty to auto-detect.
STT_LANGUAGE=

# ---------------------------------------------------------------- RAG / storage
CHROMA_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=150

# ---------------------------------------------------------------- App
MAX_UPLOAD_MB=100
# Point the Streamlit UI at a running FastAPI server instead of running the pipeline in-process:
#   uvicorn app.api:app --port 8000     then     VOICEOPS_API_URL=http://localhost:8000
VOICEOPS_API_URL=
